+/* ---------------------------------- Autocomplete produit (vente) ---------------------------------- */
+/* Remplace l'ancien <datalist> natif, peu lisible et peu tactile sur mobile :
+   ce menu déroulant maison filtre en direct pendant la saisie et se
+   sélectionne au clic/tap, aussi bien sur mobile que sur PC. */
+
+.product-autocomplete {
+  position: relative;
+}
+
+.product-autocomplete__input-row {
+  position: relative;
+  display: flex;
+  align-items: stretch;
+}
+
+.product-autocomplete__input-row input {
+  flex: 1 1 auto;
+  min-width: 0;
+  padding-right: 44px; /* laisse la place au bouton triangle */
+}
+
+.product-autocomplete__toggle {
+  position: absolute;
+  right: 4px;
+  top: 4px;
+  bottom: 4px;
+  width: 38px;
+  border: none;
+  background: none;
+  color: var(--color-text-muted);
+  font-size: 18px;
+  line-height: 1;
+  cursor: pointer;
+  border-radius: var(--radius-sm, 6px);
+  transition: background var(--duration-fast) var(--ease-standard),
+              transform var(--duration-fast) var(--ease-standard);
+}
+
+.product-autocomplete__toggle:hover,
+.product-autocomplete__toggle:focus-visible {
+  background: var(--color-primary-light);
+  outline: none;
+}
+
+.product-autocomplete__toggle--open {
+  transform: rotate(180deg);
+}
+
+.product-autocomplete__list {
+  position: absolute;
+  z-index: 30;
+  top: calc(100% + 4px);
+  left: 0;
+  right: 0;
+  max-height: 240px;
+  overflow-y: auto;
+  background: var(--color-surface);
+  border: 1.5px solid var(--color-border-strong);
+  border-radius: var(--radius-md);
+  box-shadow: var(--shadow-lg, 0 8px 24px rgba(0, 0, 0, 0.12));
+  padding: var(--space-1, 4px) 0;
+}
+
+.product-autocomplete__list[hidden] {
+  display: none;
+}
+
+.product-autocomplete__item {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  width: 100%;
+  padding: var(--space-3) var(--space-4);
+  background: none;
+  border: none;
+  text-align: left;
+  font-size: var(--fs-base);
+  color: var(--color-text);
+  cursor: pointer;
+}
+
+.product-autocomplete__item:hover,
+.product-autocomplete__item:focus-visible,
+.product-autocomplete__item--active {
+  background: var(--color-primary-light);
+  outline: none;
+}
+
+.product-autocomplete__item-stock {
+  font-size: var(--fs-sm);
+  color: var(--color-text-muted);
+  white-space: nowrap;
+}
+
+.product-autocomplete__item--out {
+  opacity: 0.55;
+}
+
+.product-autocomplete__empty {
+  padding: var(--space-3) var(--space-4);
+  font-size: var(--fs-sm);
+  color: var(--color-text-muted);
+}
+

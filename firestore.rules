rules_version = '2';

// ==============================================================
// Kontra-Africa — Règles de sécurité Firestore
//
// PRINCIPE GÉNÉRAL :
// Le backend (Render / Firebase Functions) utilise le SDK Admin,
// qui CONTOURNE ces règles. Ces règles ne s'appliquent qu'aux
// appels faits directement depuis le navigateur (SDK client Web).
//
// Objectif : empêcher un utilisateur connecté de modifier lui-même
// des champs qui doivent être 100% contrôlés par le serveur
// (statut d'abonnement, clé de licence, etc.), sous peine de
// pouvoir débloquer l'app gratuitement en appelant updateDoc()
// directement depuis la console du navigateur.
// ==============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // USERS
    // ----------------------------------------------------------
    match /users/{userId} {

      // Un utilisateur ne peut lire que son propre document.
      // L'admin (email fixe) peut tout lire pour le panneau admin.
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         request.auth.token.email == 'optisitedigital@gmail.com');

      // La création du profil se fait normalement via le backend
      // (initUser), mais on autorise aussi la création directe par
      // le propriétaire du compte, sans jamais lui permettre de se
      // définir un abonnement actif dès la création.
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        (!('subscriptionStatus' in request.resource.data) ||
          request.resource.data.subscriptionStatus == 'trial') &&
        !('chariowLicenseKey' in request.resource.data);

      // Mise à jour : le propriétaire peut modifier UNIQUEMENT les
      // champs métier non sensibles (solde, objectifs d'épargne,
      // devise, profil). Il ne peut JAMAIS toucher aux champs qui
      // déterminent l'accès payant : ceux-là sont exclusivement
      // gérés par le backend via le SDK Admin.
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscriptionStatus',
          'subscriptionExpiresAt',
          'chariowLicenseKey',
          'trialStartDate',
          'trialEndDate',
          'uid',
          'createdAt',
          'lastFailedSaleAt',
          'lastFailedSaleEvent'
        ]);

      allow delete: if false;
    }

    // ----------------------------------------------------------
    // CONTRACTS
    // ----------------------------------------------------------
    match /contracts/{contractId} {

      // Seul le créateur peut lire son propre contrat depuis l'app
      // (la vue publique de signature passe par le backend avec le
      // SDK Admin via /api/contracts/public/:token, donc pas besoin
      // d'ouvrir la lecture publique ici).
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.creatorId;

      // Création directe autorisée depuis l'app créateur, mais le
      // contrat doit obligatoirement démarrer au statut "pending",
      // non signé, sans compteur PDF déjà lancé.
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.creatorId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.signerSignedAt == null &&
        request.resource.data.pdfAccessStartedAt == null &&
        request.resource.data.pdfExpiresAt == null;

      // Toute mise à jour (signature client, expiration après 24h,
      // démarrage du compteur PDF) passe exclusivement par le
      // backend (SDK Admin, hors-règles). Le client ne modifie ni
      // ne supprime jamais un contrat directement.
      allow update: if false;
      allow delete: if false;
    }

    // ----------------------------------------------------------
    // ADMIN SETTINGS (taux de change USD/FC affiché dans /admin.html)
    // ----------------------------------------------------------
    match /admin_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email == 'optisitedigital@gmail.com';
    }

    // ----------------------------------------------------------
    // Par défaut : tout le reste est fermé.
    // ----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

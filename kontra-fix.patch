diff --git a/firestore.rules b/firestore.rules
index 238c619..afd2b66 100644
--- a/firestore.rules
+++ b/firestore.rules
@@ -45,6 +45,46 @@ service cloud.firestore {
         allow read: if isOwner(userId) || isAdmin();
         allow write: if false;
       }
+      // -----------------------------------------------------------------
+      // STOCK — produits (lu/écrit directement par le client, en temps réel)
+      // -----------------------------------------------------------------
+      match /stockProducts/{productId} {
+        allow read: if isOwner(userId) || isAdmin();
+        allow create, update: if isOwner(userId)
+          && request.resource.data.name is string
+          && request.resource.data.purchasePrice is number
+          && request.resource.data.purchasePrice >= 0
+          && request.resource.data.sellingPrice is number
+          && request.resource.data.sellingPrice >= 0
+          && request.resource.data.stockQuantity is number
+          && request.resource.data.stockQuantity >= 0;
+        allow delete: if false;
+      }
+      // -----------------------------------------------------------------
+      // STOCK — ventes en attente de clôture (lues/écrites par le client ;
+      // supprimées uniquement par le serveur, via /reports/close-day/confirm,
+      // qui utilise firebase-admin et ne passe donc pas par ces règles).
+      // -----------------------------------------------------------------
+      match /stockSales/{saleId} {
+        allow read: if isOwner(userId) || isAdmin();
+        allow create: if isOwner(userId)
+          && request.resource.data.productId is string
+          && request.resource.data.quantity is number
+          && request.resource.data.quantity > 0;
+        allow update: if false;
+        // Autorisé : retirer une vente non encore clôturée (bouton
+        // "Retirer" dans l'onglet Ventes).
+        allow delete: if isOwner(userId);
+      }
+      // -----------------------------------------------------------------
+      // STOCK — bilan mensuel : lecture seule côté client. N'est jamais
+      // écrit que par le serveur (firebase-admin) à chaque clôture de
+      // journée, pour garantir un historique fiable.
+      // -----------------------------------------------------------------
+      match /stockMonthlyReports/{monthId} {
+        allow read: if isOwner(userId) || isAdmin();
+        allow write: if false;
+      }
     }
     // -----------------------------------------------------------------------
     // CONTRACTS

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -----------------------------------------------------------------------
    // ADMIN
    // -----------------------------------------------------------------------
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'optisitedigital@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // -----------------------------------------------------------------------
    // UTILISATEUR CONNECTÉ
    // -----------------------------------------------------------------------
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }
    // Liste blanche : SEULS ces champs peuvent être modifiés par l'utilisateur
    // directement depuis le client.
    function isOnlyChangingAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'displayName',
          'photoURL',
          'currencySymbol',
          'exchangeRate',
          'exchangeRateUpdatedAt',
          'displayCurrency',
          'savingsGoalAmount',
          'savingsCurrentAmount',
          'balance'
        ]);
    }
    // -----------------------------------------------------------------------
    // USERS
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false;
      allow update: if isOwner(userId)
        && isOnlyChangingAllowedFields();
      allow delete: if false;
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }
    // -----------------------------------------------------------------------
    // CONTRACTS
    // -----------------------------------------------------------------------
    match /contracts/{contractId} {
      allow read: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.signerSignedAt == null
        && request.resource.data.pdfAccessStartedAt == null
        && request.resource.data.pdfExpiresAt == null;
      allow update, delete: if false;
    }
    // -----------------------------------------------------------------------
    // ADMIN SETTINGS
    // -----------------------------------------------------------------------
    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }
    // -----------------------------------------------------------------------
    // FILET DE SÉCURITÉ
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
